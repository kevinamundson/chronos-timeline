{
  "name": "timeline-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Universal Ancient History Timeline Portal - data, schemas, validation, static site",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/validate.mjs && node site/build.mjs && pagefind --site site/dist",
    "preview": "node site/serve.mjs",
    "verify": "node site/verify.mjs && node site/verify-timelines.mjs",
    "verify:live": "node site/verify-timelines.mjs --base https://chronos.kevinamundson.me --shots",
    "dore:thumbs": "node scripts/dore/fetch-thumbs.mjs"
  },
  "devDependencies": {
    "@bibleup/bibleup": "^1.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "family-chart": "^0.9.0",
    "leaflet": "^1.9.4",
    "pagefind": "^1.5.2",
    "playwright": "^1.64.1",
    "sharp": "^0.34.5",
    "vis-timeline": "^8.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
