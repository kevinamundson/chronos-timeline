{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timeline-portal.local/schema/raleigh-accounts.schema.json",
  "title": "Raleigh accounts",
  "description": "Passages from the 1617 History of the World, each stored once, and the person or event records that quote them. Kevin approved this file on 2026-11-07 (open question N, ruling C). The plain passage is verbatim. Italic spans are not stored: build and validate derive them from the unadorned <hi> tags.",
  "type": "object",
  "additionalProperties": false,
  "required": ["passages", "accounts"],
  "properties": {
    "passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "citation", "signature", "signature_end", "passage"],
        "properties": {
          "id": { "type": "string", "pattern": "^p[0-9]{5}$" },
          "order": { "type": "integer", "minimum": 1 },
          "citation": { "type": "string", "minLength": 8 },
          "signature": { "type": "string", "minLength": 1 },
          "signature_end": { "type": "string", "minLength": 1 },
          "passage": { "type": "string", "minLength": 1 }
        }
      }
    },
    "accounts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^p[0-9]{5}$" }
      }
    }
  }
}
